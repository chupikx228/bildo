DATABASE_URL=postgresql+asyncpg://bildo:bildo@localhost:5432/bildo
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO

ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_MODEL=deepseek/deepseek-v4-flash
ROUTERAI_ENRICHER_MODEL=deepseek/deepseek-v4-flash
ROUTERAI_MAX_RETRIES=3
ROUTERAI_IGNORED_PROVIDERS=["OpenInference", "yandex"]
# Price ceiling, USD per 1M output tokens at the upstream provider, keyed by model id.
# An exact id wins (an empty object there turns the cap off for that id). Otherwise a trailing
# snapshot date (-MMDD or -YYYYMMDD) is stripped and the lookup repeated: with the default below,
# deepseek/deepseek-v4-flash-0731 is capped too. Suffixes like -pro, -lite or -vision-exp never match.
# {} turns the cap off.
ROUTERAI_MAX_PRICE_BY_MODEL={"deepseek/deepseek-v4-flash": {"completion": 1.0}}
